<Page x:Class="gestorUsuarios.EmpleadosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="EmpleadosPage">

    <!-- Recursos de estilos -->
    <Page.Resources>

        <!-- Estilo para Label -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Estilo para TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#888"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="250"/>
        </Style>

        <!-- Estilo para Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Estilo específico para el botón Cancelar -->
        <Style TargetType="Button" x:Key="CancelButtonStyle" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#e74c3c"/>
        </Style>

    </Page.Resources>

    <!-- Contenido de la página -->
    <Grid Background="#f4f6f9" Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <!-- FORMULARIO EMPLEADO -->
            <Separator Margin="10"/>
            <Label Content="Id Empleado"/>
            <TextBox x:Name="txtIdEmpleado" IsReadOnly="True"/>

            <Label Content="Nombre"/>
            <TextBox x:Name="txtNombre"/>

            <Label Content="Cargo"/>
            <TextBox x:Name="txtCargo"/>

            <Label Content="Salario"/>
            <TextBox x:Name="txtSalario"/>

            <Label Content="Correo"/>
            <TextBox x:Name="txtCorreo"/>

            <!-- Botones -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="btnCrearEmpleado" Content="Crear Empleado" Width="120" Click="BtnCrearEmpleado_Click"/>
                <Button x:Name="btnCancelar" Content="Cancelar" Width="120" Style="{StaticResource CancelButtonStyle}" Click="BtnCancelar_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>