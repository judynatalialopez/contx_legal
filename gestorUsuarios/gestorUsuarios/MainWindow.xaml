<Window x:Class="gestorUsuarios.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gestorUsuarios"
        mc:Ignorable="d"
        Title="Gestor de Roles" Height="450" Width="800"
        Background="#f4f6f9">

    <Window.Resources>
        

        <!-- Estilo para Botón -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="35"/>
        </Style>
    </Window.Resources>
 
    <Grid Margin="20">
        

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
           

            <Button Content="Form Crear Rol" Margin="0,15,0,0" Click="Button_Click"/>
            <Button Content="Form Crear Usuario" Margin="0,15,0,0" Click="Button_Click_User"/>
            <Button Content="Form Crear Empleado" Margin="0,15,0,0" Click="Button_Click_Empleado"/>

        </StackPanel>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/> 
    </Grid>
</Window>
